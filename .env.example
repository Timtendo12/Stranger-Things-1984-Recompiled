# Optional build settings. Copy this file to .env (which git ignores) and fill in what you need.
# Real environment variables with the same names take precedence over .env.
# Nothing here is needed for a normal build.

# Path to the Unity editor executable, if Unity Hub's default location is not used.
#   Windows: C:\Program Files\Unity\Hub\Editor\6000.2.6f2\Editor\Unity.exe
#   macOS:   /Applications/Unity/Hub/Editor/6000.2.6f2/Unity.app/Contents/MacOS/Unity
#   Linux:   ~/Unity/Hub/Editor/6000.2.6f2/Editor/Unity
UNITY_EDITOR=

# Discord Rich Presence (Windows, macOS and Linux). This is the numeric application id from
# https://discord.com/developers/applications. Leave it empty to build without presence.
DISCORD_CLIENT_ID=
# Key of a Rich Presence art asset uploaded to that application, used as the large image (optional).
DISCORD_LARGE_IMAGE_KEY=
# Set to false to leave presence out of the build while keeping the id.
DISCORD_ENABLED=true
