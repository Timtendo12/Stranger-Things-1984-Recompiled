# ---------------------------------------------------------------------------
# Proprietary game files: never commit these. tools/setup.py regenerates them
# locally from your own APK.
# ---------------------------------------------------------------------------
*.apk
*.apkm
*.xapk
*.apks
*.obb

# Everything under Assets/ is generated by setup unless re-included below.
/UnityProject/Assets/*
!/UnityProject/Assets/Scripts/
!/UnityProject/Assets/Scripts.meta
!/UnityProject/Assets/Editor/
!/UnityProject/Assets/Editor.meta
!/UnityProject/Assets/ShaderIncludes/
!/UnityProject/Assets/ShaderIncludes.meta
!/UnityProject/Assets/csc.rsp
!/UnityProject/Assets/csc.rsp.meta
# Web build: IL2CPP stripping rules and the page template (tools/build.py --target web).
!/UnityProject/Assets/link.xml
!/UnityProject/Assets/link.xml.meta
!/UnityProject/Assets/WebGLTemplates/
!/UnityProject/Assets/WebGLTemplates.meta
# Web favicon, downloaded by tools/build.py (as is Assets/PCIcon, ignored above).
/UnityProject/Assets/WebGLTemplates/StrangerThings/favicon.png
/UnityProject/Assets/WebGLTemplates/StrangerThings/favicon.png.meta

# Plugins: only the ported first-pass sources are ours; the stub DLLs come from setup.
!/UnityProject/Assets/Plugins/
!/UnityProject/Assets/Plugins.meta
/UnityProject/Assets/Plugins/*
!/UnityProject/Assets/Plugins/Assembly-CSharp-firstpass/
!/UnityProject/Assets/Plugins/Assembly-CSharp-firstpass.meta

# Hand-written replacements for shaders the original build ships compiled-only.
# Only the .shader source is tracked; its .meta (asset GUID) comes from setup.
!/UnityProject/Assets/Resources/
/UnityProject/Assets/Resources/*
!/UnityProject/Assets/Resources/shaders/
/UnityProject/Assets/Resources/shaders/*
!/UnityProject/Assets/Resources/shaders/VertexColorOnly.shader
!/UnityProject/Assets/Resources/shaders/chaptertitleshader.shader
!/UnityProject/Assets/Resources/shaders/bxpdynamicfont4.shader
!/UnityProject/Assets/Resources/shaders/bxpdynamicfontoutlinevertshadow.shader
!/UnityProject/Assets/Resources/shaders/bxpdynamicfontshadow4.shader
!/UnityProject/Assets/Resources/shaders/bxpparticleadditivesoft.shader
!/UnityProject/Assets/Resources/shaders/bxpuiadditive.shader
!/UnityProject/Assets/Resources/shaders/bxpuidefault.shader
!/UnityProject/Assets/Resources/shaders/bxpunlitalphavertexcolor.shader
!/UnityProject/Assets/Shader/
/UnityProject/Assets/Shader/*
!/UnityProject/Assets/Shader/Custom_Pixelate.shader

# ---------------------------------------------------------------------------
# Generated / local
# ---------------------------------------------------------------------------
/.cache/
/dist/
/.env
DiscordConfig.Generated.cs
DiscordConfig.Generated.cs.meta
*.log
__pycache__/
*.pyc

# Unity
/UnityProject/[Ll]ibrary/
/UnityProject/[Tt]emp/
/UnityProject/[Ll]ogs/
/UnityProject/[Oo]bj/
/UnityProject/[Bb]uild/
/UnityProject/[Uu]ser[Ss]ettings/
/UnityProject/MemoryCaptures/
/UnityProject/*.csproj
/UnityProject/*.sln
/UnityProject/*.slnx
/UnityProject/.vs/
/UnityProject/.vscode/
/UnityProject/.idea/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vs/
.vscode/
